# publish_pipeline — every setting, and what each one degrades to.
# Nothing here is required: the defaults run the full scenario as shipped.

# --- identity of the publishing provider -------------------------------------
# A Beckn Catalog MUST carry a provider with a stable id. In production this is
# the network-registered participant id; here it is configuration, because
# inventing a registry entry would be worse than admitting we lack one.
BECKN_PROVIDER_ID=prov-imd-agromet
BECKN_PROVIDER_CODE=IMD-AGROMET
BECKN_PROVIDER_NAME=India Meteorological Department — Agromet Advisory Services
BECKN_DOMAIN=agriculture

# --- schema namespace --------------------------------------------------------
# NOTE: this URL does not resolve today — the OpenAgriNet schema namespace is
# not published yet (checked: DNS failure). It is emitted because
# message_update.json carries it and because @context is REQUIRED by
# beckn.yaml's Attributes schema. Flagged rather than quietly replaced.
OPENAGRI_SCHEMA_BASE=https://schemas.openagrinet.global/schema
OPENAGRI_TAXONOMY_BASE=https://taxonomy.openagrinet.global
OPENAGRI_SCHEMA_VERSION=v0.1

# --- branch 2b: embeddings ---------------------------------------------------
# local   -> sentence-transformers, real 1024-d multilingual vectors (default)
# remote  -> an OpenAI-compatible /v1/embeddings endpoint, same model
# lexical -> hashed character n-grams. No download. Matches SPELLINGS, NOT
#            MEANINGS, and stamps semantic=False on every result.
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
EMBEDDING_BATCH=16
# Auto-detects cuda, then Apple Silicon mps, then cpu. Set explicitly to
# reproduce a CPU timing.
# EMBEDDING_DEVICE=cpu
# EMBEDDING_BASE_URL=https://your-embeddings-host/v1
# EMBEDDING_API_KEY=

# --- branch 2b: vector store -------------------------------------------------
# "local" runs Qdrant embedded, in-process, against QDRANT_PATH — no server,
# no Docker. Anything else is treated as the URL of a running Qdrant.
QDRANT_URL=local
# QDRANT_PATH defaults to <package>/.qdrant
QDRANT_COLLECTION=agri_passages_v4

# --- passage segmentation ----------------------------------------------------
# The max is set by the MODEL, not by taste: e5-large has a 512-token window and
# truncates beyond it silently. Devanagari tokenizes 2-3x less efficiently than
# Latin, so a limit safe for the Karnataka bulletin would clip the Hindi ones.
# 700 chars keeps every observed passage inside the window (measured max: 314
# tokens). embeddings.token_report() re-checks this on every run.
MIN_PASSAGE_CHARS=80
MAX_PASSAGE_CHARS=700

# --- language detection ------------------------------------------------------
# A page is non-English only if the dominant Indic script clears BOTH an
# absolute character count and a share of all letters, so one stray glyph in an
# English table cannot flip it.
LANG_MIN_CHARS=15
LANG_MIN_RATIO=0.05

# --- publish -----------------------------------------------------------------
# Empty (the default) uses the in-process NetworkNode stand-in. Set it to POST
# at a real /catalog/publish endpoint; note that a real node is opaque, so the
# round-trip verification is skipped and reported as such.
BECKN_NETWORK_NODE_URL=
BECKN_VISIBLE_TO=local-network
BECKN_CATALOG_TYPE=REGULAR
